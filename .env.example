# ---- AI model (all optional: without a key the agent runs in deterministic rules + templates mode)
# Provider: anthropic | openai (any OpenAI-compatible endpoint) | none
LLM_PROVIDER=anthropic
# API auth token for the model. ANTHROPIC_API_KEY / OPENAI_API_KEY are also read.
LLM_API_KEY=
# Optional overrides
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_S=30

# ---- SOP knobs
MIN_IDENTITY_FIELDS=3
MAX_VERIFICATION_FAILURES=3
MAX_OUT_OF_SCOPE=3
MAX_PERSUASION_ATTEMPTS=3
# default | timeout  (consent behaviour when a representative calls)
CONSENT_SCENARIO=default
# Fixture timeline is early 2026 (CL-2048 appeal deadline 2026-03-18). Use "real" for the system date.
DEMO_TODAY=2026-02-20

# ---- Optional real email delivery (otherwise summaries go to data/outbox/*.json)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=claims-support@example.com
